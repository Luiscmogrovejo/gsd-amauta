{
  "name": "gsd-amauta",
  "version": "2.8.0",
  "description": "Amauta v2: Claude Code plugin for multi-agent task management with RPETD pipeline, MCP integration, PostgreSQL/SQLite memory, RLM context engine, and GSD spec-driven development.",
  "bin": {
    "gsd-amauta": "bin/cli.cjs",
    "gsd-amauta-install": "bin/install.js",
    "amauta-install": "bin/install.js",
    "amauta": "get-shit-done/bin/amauta.cjs",
    "amauta-memory": "get-shit-done/bin/gsd-memory.cjs",
    "gsd-amauta-mcp": "bin/mcp-server.cjs"
  },
  "files": [
    "bin",
    "commands",
    "get-shit-done",
    "agents",
    "skills",
    "hooks/dist",
    "scripts",
    "services",
    "docker",
    "migrations",
    "references"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "opencode",
    "ai",
    "multi-agent",
    "task-management",
    "rpetd",
    "rlm",
    "amauta",
    "postgresql",
    "memory",
    "spec-driven-development",
    "mcp",
    "ai-agent"
  ],
  "author": "Luis Carlos Mogrovejo de Piérola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luiscmogrovejo/gsd-amauta.git"
  },
  "homepage": "https://github.com/Luiscmogrovejo/gsd-amauta",
  "bugs": {
    "url": "https://github.com/Luiscmogrovejo/gsd-amauta/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-typescript": "^0.21.2"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^16.3.0",
    "@playwright/test": "^1.44.0",
    "c8": "^11.0.0",
    "esbuild": "^0.24.0",
    "fast-check": "^3.20.0"
  },
  "scripts": {
    "install": "node bin/install.js",
    "start-daemon": "python3 services/amauta-daemon.py &",
    "stop-daemon": "kill $(cat services/amauta-daemon.pid) 2>/dev/null || true",
    "start-pg": "docker compose -f docker/docker-compose.yml up -d",
    "stop-pg": "docker compose -f docker/docker-compose.yml down",
    "migrate": "for f in migrations/0[0-9][0-9]-*.sql; do case \"$f\" in *DOWN*) continue;; esac; echo \"Running $f...\"; docker exec -i gsd-postgres psql -U gsd -d gsd_amauta < \"$f\"; done",
    "build:hooks": "node scripts/build-hooks.js",
    "test": "node scripts/run-tests.cjs",
    "test:behavioral": "node scripts/run-behavioral-tests.cjs",
    "test:coverage": "c8 --check-coverage --lines 70 --reporter text --include 'get-shit-done/bin/lib/*.cjs' --exclude 'tests/**' --all node scripts/run-tests.cjs"
  }
}
