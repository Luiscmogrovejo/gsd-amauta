{
  "name": "gsd-amauta",
  "version": "1.0.0",
  "description": "Amauta v1: Claude Code plugin for multi-agent task management with RPETD pipeline, PostgreSQL memory, RLM context engine, and GSD spec-driven development.",
  "bin": {
    "gsd-amauta-install": "bin/install.js",
    "amauta-install": "bin/install.js",
    "amauta": "get-shit-done/bin/amauta.cjs",
    "amauta-memory": "get-shit-done/bin/gsd-memory.cjs"
  },
  "files": [
    "bin",
    "commands",
    "get-shit-done",
    "agents",
    "hooks/dist",
    "scripts",
    "services",
    "docker",
    "migrations",
    "references"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "opencode",
    "ai",
    "multi-agent",
    "task-management",
    "rpetd",
    "rlm",
    "amauta",
    "postgresql",
    "memory",
    "spec-driven-development"
  ],
  "author": "Luis Carlos Mogrovejo de Piérola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertamauta/gsd-amauta.git"
  },
  "homepage": "https://github.com/robertamauta/gsd-amauta",
  "bugs": {
    "url": "https://github.com/robertamauta/gsd-amauta/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "esbuild": "^0.24.0"
  },
  "scripts": {
    "install": "node bin/install.js",
    "start-daemon": "python3 services/amauta-daemon.py &",
    "stop-daemon": "kill $(cat services/amauta-daemon.pid) 2>/dev/null || true",
    "start-pg": "docker compose -f docker/docker-compose.yml up -d",
    "stop-pg": "docker compose -f docker/docker-compose.yml down",
    "migrate": "docker exec gsd-postgres psql -U gsd -d gsd_amauta -f /docker-entrypoint-initdb.d/001-init.sql",
    "build:hooks": "node scripts/build-hooks.js",
    "test": "node scripts/run-tests.cjs",
    "test:coverage": "c8 --check-coverage --lines 70 --reporter text --include 'get-shit-done/bin/lib/*.cjs' --exclude 'tests/**' --all node scripts/run-tests.cjs"
  }
}
