# Copy to docker/.env — `docker compose -f docker/docker-compose.yml` reads it
# automatically. Every value here is also read by services/pg_dsn.py, so the
# compose stack and the Python services cannot disagree about where Postgres is.

# Host port for the Postgres container. Change it if 5433 is taken.
GSD_PG_PORT=5433

# Host port for the Valkey container (--profile cache). Leave the container
# OFF if you already run Redis/Valkey on this port: services/infra_detect.py
# reuses whatever is listening there rather than failing the whole stack.
GSD_REDIS_PORT=6379

# Host port for the MCP SSE container (--profile mcp).
GSD_MCP_PORT=18800

# Postgres credentials and database name.
POSTGRES_USER=gsd
POSTGRES_PASSWORD=gsd
GSD_PG_DB=gsd_amauta

# Named volume for the Postgres data directory. Change it to run a second,
# isolated stack side by side with the default one.
GSD_PG_VOLUME=gsd-pg-data
