# ── PostgreSQL ──────────────────────────────────────────
GSD_POSTGRES_URL=postgresql://gsd:gsd@127.0.0.1:5433/gsd_amauta

# ── Daemon ──────────────────────────────────────────────
GSD_AMAUTA_PORT=18799
AMAUTA_DAEMON_TOKEN=          # Set to enable bearer auth (leave empty for dev)
AMAUTA_MAX_BODY_SIZE=10485760 # 10MB max request body
AMAUTA_DATA_DIR=.             # Directory containing tasks.json

# ── RLM Context Engine ─────────────────────────────────
GSD_RLM_PORT=18798
RLM_CACHE_SIZE=200            # Max cached file entries
RLM_CACHE_MAX_MB=512          # Max cache memory in MB
RLM_MAX_CHUNK_CHARS=8000      # Max chars per chunk
RLM_DEFAULT_TOP_K=10          # Default number of results

# ── LLM Distillation (optional) ──────────────────────
# Claude CLI is used automatically in Claude Code sessions (no key needed)
# ANTHROPIC_API_KEY is only needed as fallback outside Claude Code
# ANTHROPIC_API_KEY=          # Optional: HTTP API fallback for distillation

# ── Embedding Providers (optional) ─────────────────────
VOYAGE_API_KEY=               # Voyage AI for code embeddings
OPENAI_API_KEY=               # OpenAI fallback for embeddings

# ── Research Chain (optional) ──────────────────────────
PERPLEXITY_API_KEY=           # Perplexity for real-time web search
PERPLEXITY_MODEL=auto         # auto (selects sonar/sonar-pro by query complexity), sonar, sonar-pro

# ── Validation ─────────────────────────────────────────
AMAUTA_GATE_COOLDOWN_MINUTES=20

# ── Debug ──────────────────────────────────────────────
GSD_DEBUG=                    # Set to 1 for verbose daemon logging
NO_COLOR=                     # Set to 1 to disable ANSI colors

# ── Logging ───────────────────────────────────────────
AMAUTA_LOG_LEVEL=INFO         # DEBUG, INFO, WARNING, ERROR
AMAUTA_LOG_FORMAT=text        # "text" or "json" (structured logging)

# ── Smart Infrastructure Detection ───────────────────
# GSD_POSTGRES_URL is auto-detected if not set:
#   1. Local PostgreSQL (ports 5432-5434)
#   2. Docker PostgreSQL (gsd container, port 5433)
#   3. SQLite fallback (~/.amauta/data/gsd_amauta.db)
# GSD_BACKEND=                # Force: "postgresql" or "sqlite" (auto-detected if empty)
# GSD_DATA_DIR=               # SQLite data dir (default: ~/.amauta/data)
# GSD_SQLITE_PATH=            # Override SQLite file path

# ── Advanced (usually defaults are fine) ──────────────
# GSD_EMBEDDING_PROVIDER=     # Override: "voyage" or "openai"
# GSD_RLM_HOST=127.0.0.1     # RLM service host
# GSD_AMAUTA_HOST=127.0.0.1  # Daemon host
# PERPLEXITY_MODEL=auto       # auto (default), sonar, sonar-pro, sonar-reasoning-pro
# AMAUTA_MEMORY_DATABASE_URL= # Alternative PG DSN
# AMAUTA_MEMORY_BACKEND=      # "postgres" or "file"
# AMAUTA_SHARED_KB_DIR=       # Override shared KB root path
