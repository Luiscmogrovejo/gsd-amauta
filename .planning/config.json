{
  "mode": "yolo",
  "granularity": "coarse",
  "parallelization": true,
  "commit_docs": false,
  "model_profile": "balanced",
  "current_milestone": "v3.1",
  "model_routing": {
    "R": "sonnet",
    "P": "sonnet",
    "E": "sonnet",
    "T": "haiku",
    "D": "haiku",
    "compaction": "haiku"
  },
  "workflow": {
